# ===========================================
# Lookout Grid — Environment Variables
# Copy this file to .env and fill in real values
# ===========================================
# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lookoutgrid
DB_USER=lookoutgrid_user
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
# --- MQTT Broker ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=lookoutgrid_backend
MQTT_PASSWORD=CHANGE_ME
# --- JWT Auth ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# --- Firebase (Push Notifications) ---
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# --- SMS Gateway (Fast2SMS or Twilio) ---
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=CHANGE_ME
# Or for Twilio:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=CHANGE_ME
# TWILIO_AUTH_TOKEN=CHANGE_ME
# TWILIO_FROM_NUMBER=+1234567890
# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# --- Logging ---
LOG_LEVEL=INFO
